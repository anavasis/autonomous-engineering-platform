# AEP Mission Control — production environment example
# Copy to deploy/.env and set strong credentials before going live.

AEP_BOOTSTRAP_ADMIN_USERNAME=admin
AEP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
AEP_BOOTSTRAP_ADMIN_DISPLAY=AEP Administrator

# Optional overrides used by local/non-compose runs
AEP_DATA_ROOT=/var/aep/data
AEP_VERSION=0.8.0

# Multi-agent collaboration
AEP_AGENTS_CONFIG=/var/aep/deploy/agents.json
