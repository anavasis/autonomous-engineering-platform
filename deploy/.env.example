# AEP Mission Control — production environment example
# Copy to deploy/.env and set strong credentials before going live.

AEP_BOOTSTRAP_ADMIN_USERNAME=admin
AEP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
AEP_BOOTSTRAP_ADMIN_DISPLAY=AEP Administrator

# Optional overrides used by local/non-compose runs
AEP_DATA_ROOT=/var/aep/data

# Optional runtime version override only.
# Normally leave unset — the repository/image VERSION file is canonical.
# Set AEP_VERSION only for an intentional override (e.g. AEP_VERSION=1.7.4).
# AEP_VERSION=

# Live Mission Execution streaming (SSE). When true, Mission Details uses EventSource.
AEP_SSE_ENABLED=true

# Execution Runtime (async Mission Engine jobs). Worker required in production.
# AEP_RUNTIME_INLINE=true  # process jobs in-request (tests/dev only; disables async)
AEP_RUNTIME_LEASE_SECONDS=60
# AEP_RUNTIME_WORKER_ID=worker-1

# Internal HTTP proxy bind (host Nginx reverse-proxies to this).
# Docker publishes 127.0.0.1:${AEP_PROXY_PORT}:80 — never host 80/443.
AEP_PROXY_PORT=8088

# Real Cursor CLI provider (type cursor-cli). Absolute path preferred.
# Example: /usr/local/bin/cursor-agent
AEP_CURSOR_CLI_BINARY=cursor-agent

# Real Claude Code CLI provider (type claude-code-cli). Absolute path preferred.
# Example: /usr/local/bin/claude
AEP_CLAUDE_CODE_CLI_BINARY=claude
# Host auth for Claude Code (inherited by the process; not stored by AEP):
# ANTHROPIC_API_KEY=sk-ant-...
# and/or prior `claude` login credentials under ~/.claude

# Real OpenAI Codex CLI provider (type codex-cli).
# Binary is baked into the API/worker image at /usr/local/bin/codex (pinned 0.145.0).
# Preferred auth: interactive Sign in with ChatGPT after deploy (no API keys required).
# Worker HOME is /var/aep/codex-home via the dedicated codex_home volume — credentials
# live there as ~/.codex and must never be committed to Git.
# After deploy, one-off login (same image + volume; do not capture token output):
#   cd deploy && docker compose run --rm --no-deps --entrypoint codex worker login
# Deleting the codex_home volume logs the worker out (credentials removed).
# Optional binary override (normally leave unset):
# AEP_CODEX_CLI_BINARY=/usr/local/bin/codex
# API-key auth is an alternative path and is NOT required for ChatGPT login:
# OPENAI_API_KEY / CODEX_API_KEY — do not commit; prefer ChatGPT login above.

# Real Gemini CLI provider (type gemini-cli). Absolute path preferred.
# Example: /usr/local/bin/gemini
AEP_GEMINI_CLI_BINARY=gemini
# Host auth for Gemini (inherited by the process; not stored by AEP):
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_GENAI_USE_VERTEXAI=true

# Multi-agent collaboration
AEP_AGENTS_CONFIG=/var/aep/deploy/agents.json

# Resource intelligence
AEP_OPTIMIZATION_CONFIG=/var/aep/deploy/optimization.json

# Engineering governance
AEP_GOVERNANCE_CONFIG=/var/aep/deploy/governance.json

# Engineering Execution provider catalog (not a secret).
# API and worker must use the same path so both load identical providers.
# Compose mounts deploy/execution-providers.json here and sets this env.
# Discoverability only: CLI binaries and credentials are configured separately
# (AEP_*_CLI_BINARY / vendor API keys). Mounting the catalog alone makes
# providers visible in Settings/API; they remain unavailable until binaries exist.
AEP_EXECUTION_PROVIDERS_CONFIG=/var/www/aep/deploy/execution-providers.json
