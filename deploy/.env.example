# AEP Mission Control — production environment example
# Copy to deploy/.env and set strong credentials before going live.

AEP_BOOTSTRAP_ADMIN_USERNAME=admin
AEP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
AEP_BOOTSTRAP_ADMIN_DISPLAY=AEP Administrator

# Optional overrides used by local/non-compose runs
AEP_DATA_ROOT=/var/aep/data
AEP_VERSION=1.5.0

# Internal HTTP proxy bind (host Nginx reverse-proxies to this).
# Docker publishes 127.0.0.1:${AEP_PROXY_PORT}:80 — never host 80/443.
AEP_PROXY_PORT=8088

# Real Cursor CLI provider (type cursor-cli). Absolute path preferred.
# Example: /usr/local/bin/cursor-agent
AEP_CURSOR_CLI_BINARY=cursor-agent

# Real Claude Code CLI provider (type claude-code-cli). Absolute path preferred.
# Example: /usr/local/bin/claude
AEP_CLAUDE_CODE_CLI_BINARY=claude
# Host auth for Claude Code (inherited by the process; not stored by AEP):
# ANTHROPIC_API_KEY=sk-ant-...
# and/or prior `claude` login credentials under ~/.claude

# Real OpenAI Codex CLI provider (type codex-cli). Absolute path preferred.
# Example: /usr/local/bin/codex
AEP_CODEX_CLI_BINARY=codex
# Host auth for Codex (inherited by the process; not stored by AEP):
# OPENAI_API_KEY=sk-...
# CODEX_API_KEY=sk-...   # codex exec only; preferred for single-invocation automation
# and/or prior `codex login` credentials under ~/.codex

# Real Gemini CLI provider (type gemini-cli). Absolute path preferred.
# Example: /usr/local/bin/gemini
AEP_GEMINI_CLI_BINARY=gemini
# Host auth for Gemini (inherited by the process; not stored by AEP):
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_GENAI_USE_VERTEXAI=true

# Multi-agent collaboration
AEP_AGENTS_CONFIG=/var/aep/deploy/agents.json

# Resource intelligence
AEP_OPTIMIZATION_CONFIG=/var/aep/deploy/optimization.json

# Engineering governance
AEP_GOVERNANCE_CONFIG=/var/aep/deploy/governance.json
